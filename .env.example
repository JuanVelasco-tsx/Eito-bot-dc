# Copia este archivo como ".env" y completa los valores.
# El archivo .env NO se sube a GitHub (esta en .gitignore).

# Token del bot de Discord (obligatorio).
DISCORD_TOKEN=pon_aqui_tu_token

# Conexion a PostgreSQL (obligatorio; en Railway la aporta el servicio de PostgreSQL).
DATABASE_URL=postgresql://usuario:contraseña@localhost/eito_db

# ID del servidor principal: ahi !darnivel queda bloqueado (vacio = sin bloqueo, para servers de pruebas).
EITO_GUILD_ID=

# ID del canal donde se publican los avisos de nuevas versiones (vacio = busca el canal 🔧・l4d2-mod-loader).
RELEASE_CHANNEL_ID=

# Secreto Bearer de POST /release-webhook (vacio = el endpoint rechaza todas las peticiones).
RELEASE_WEBHOOK_SECRET=

# Puerto del servidor web interno (por defecto 8080; Railway lo define solo). No lo dejes definido pero vacio.
# PORT=8080
